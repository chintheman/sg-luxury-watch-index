# QA team configuration for sg-luxury-watch-index.
# Environment variables win, so CI and the self-tests can override.
QA_ADAPTER="${QA_ADAPTER:-python-pytest}"
QA_DEFAULT_BRANCH="${QA_DEFAULT_BRANCH:-main}"

# The suite runs in ~0.6s, so a full scoped mutation run is genuinely cheap
# here. Starting at the spec default; ratchet up monthly, never down.
QA_MUTATION_THRESHOLD="${QA_MUTATION_THRESHOLD:-0.60}"
QA_MUTATION_TIMEOUT_SECONDS="${QA_MUTATION_TIMEOUT_SECONDS:-900}"
QA_PR_BUDGET_USD="${QA_PR_BUDGET_USD:-8.00}"
QA_MUTATION_JSON="${QA_MUTATION_JSON:-$QA_ROOT/.qa/metrics/mutation.json}"
