        "Yacht-Master 226658": 24800, "Day-Date 228238": 49500,
        "Sea-Dweller 126600": 18500, "OP 41 124300": 8100,
        "OP 36 126000": 7700, "Milgauss 116400": 11800,
        "Air-King 126900": 9600, "Sky-Dweller 326934": 21500,
        "Sky-Dweller 336934": 21500,
